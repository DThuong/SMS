{
  "openapi": "3.1.0",
  "info": {
    "title": "SMS API (Scan MES System)",
    "version": "3.0",
    "description": "Agent lấy dữ liệu MESClient cho DYS. Gọi POST /api/auth/session bằng API key để lấy token (hạn 15 phút), rồi bấm Authorize → dán token vào ô Bearer."
  },
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "apps_core_api_health",
        "summary": "Kiểm tra API + database còn sống",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "description": "Kiểm tra API + database còn sống (dùng cho Docker healthcheck / Cloudflare)",
        "tags": [
          "Phiên & sức khỏe"
        ]
      }
    },
    "/api/auth/session": {
      "post": {
        "operationId": "apps_core_api_create_api_session",
        "summary": "Đổi API key lấy token phiên (15 phút, 1 người / khóa)",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "description": "Đổi API key lấy token phiên (hạn `session_minutes`, mặc định 15 phút). Gửi token ở header\n`Authorization: Bearer <token>` cho mọi API khác.\n\n**Mỗi API key chỉ 1 phiên / 1 người:** tạo phiên mới thì phiên cũ (nếu còn hạn) bị thay thế ngay —\nngười đang dùng phiên cũ nhận 401 `SESSION_REPLACED`. `replaced` cho biết phiên của ai vừa bị thay.\nToken gắn với `username`; gửi `X-Requested-By` khác username → 401 `SESSION_USER_MISMATCH`.\nDùng `expires_at` + `server_time` để hiển thị đồng hồ đếm ngược (trừ lệch giờ máy khách).",
        "tags": [
          "Phiên & sức khỏe"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SessionIn"
              }
            }
          },
          "required": true
        }
      },
      "get": {
        "operationId": "apps_core_api_current_session",
        "summary": "Thời gian còn lại của phiên (đồng hồ đếm ngược)",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "description": "Phiên còn dùng được không + `expires_at`, `remaining_seconds`, `server_time`, người đang dùng (401 = hết hạn / bị thay)",
        "tags": [
          "Phiên & sức khỏe"
        ],
        "security": [
          {
            "SessionBearer": []
          },
          {
            "SessionQuery": []
          }
        ]
      },
      "delete": {
        "operationId": "apps_core_api_logout_session",
        "summary": "Đăng xuất (kết thúc phiên hiện tại)",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "description": "Kết thúc phiên đang dùng → API key trống phiên, người khác đăng nhập ngay được",
        "tags": [
          "Phiên & sức khỏe"
        ],
        "security": [
          {
            "SessionBearer": []
          },
          {
            "SessionQuery": []
          }
        ]
      }
    },
