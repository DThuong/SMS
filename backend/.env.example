# Copy file này thành .env rồi điền giá trị thật
DJANGO_SECRET_KEY=doi-thanh-chuoi-ngau-nhien-dai
# 1 = phát triển; Docker tự đặt 0
DJANGO_DEBUG=1
# Tên miền / IP được phép gọi API (thêm IP máy của bạn, vd 192.168.1.50)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,sms-backend.dongyang.site,172.16.162.60
# Trang web được phép gọi API từ trình duyệt (CORS) — DYS
CORS_ALLOWED_ORIGINS=https://dys.dongyang.site,http://localhost:3000

# MySQL (chạy trên chính máy MESClient). Docker tự đổi DB_HOST thành host.docker.internal
DB_ENGINE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sms
DB_USER=sms_app
DB_PASSWORD=

# Nơi lưu file kế hoạch (mặc định backend/storage)
STORAGE_DIR=

# Docker: cổng mở ra ngoài (http://<IP máy>:SMS_PORT)
SMS_PORT=8000

# Tài khoản DYS riêng của hệ thống scan MES — worker tự đăng nhập để import file vào DYS
# (bảng settings dys_username / dys_password có giá trị thì ưu tiên hơn)
DYS_API_URL=https://172.16.162.123:9000/api
DYS_USERNAME=SCAN_MES
DYS_PASSWORD=123456
